# ИНСТРУКЦИЯ: Скопируйте этот файл, переименуйте его в .env и подставьте свои реальные значения.

# --- Настройки базы данных (PostgreSQL) ---
# ВАЖНО: Если запускаете через Docker Compose, оставьте SQL_HOST=db
# Если запускаете приложение локально (без Docker), измените на SQL_HOST=localhost
SQL_HOST=db
SQL_PORT=5432
SQL_USER=your_db_user
SQL_PASSWORD=your_super_secret_password
SQL_DB_NAME=booking_db

# --- Настройки кэша (Redis) ---
# ВАЖНО: Для Docker используйте хост redis, для локального запуска — localhost
REDIS_CONNECT=redis://redis:6379